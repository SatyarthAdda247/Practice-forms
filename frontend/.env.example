# Copy to .env.local and fill in your Google OAuth Web client ID.
# (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID -> Web application)
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend API origin for SPLIT-domain deployments (frontend and backend on
# different domains). Baked in at build time. Leave UNSET for local dev — then
# the app uses "/api" and Vite proxies it to the Flask server on :5000.
# VITE_API_BASE_URL=https://omrchecker-api.adda247.com
