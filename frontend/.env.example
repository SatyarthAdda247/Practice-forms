# Copy to .env.local and fill in your Google OAuth Web client ID.
# (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID -> Web application)
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend API origin (split-domain: frontend and backend on different domains).
#   LOCAL DEV : leave UNSET — `npm run dev` proxies /api to the Flask server on
#               :5000 (see vite.config.js), so no backend URL is needed.
#   DEPLOYED  : do NOT set here and it is NOT baked at build time. The Docker
#               image is built with a __VITE_API_BASE_URL__ placeholder, and
#               docker-entrypoint.sh replaces it at container startup with the
#               value from the K8s ConfigMap (key: VITE_API_BASE_URL).
#               Prod value: http://tools-api.adda247.com
#               (scheme + host only — no /api, no trailing slash; api.js appends
#               /api itself.)
# VITE_API_BASE_URL=
