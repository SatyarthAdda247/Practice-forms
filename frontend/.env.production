# Production build config (committed — VITE_* values are PUBLIC, baked into the
# browser bundle at build time). Used by a plain `npm run build`.
#
# NOTE: Docker image builds do NOT read this file (.dockerignore excludes
# .env.*); the frontend Dockerfile carries the same values as ARG defaults.
# Keep the two in sync.

# Split-domain deployment: frontend and backend live on separate domains.
#   Frontend: https://aspirant-portal.adda247.com
#   Backend : https://aspirant-portal-api.adda247.com
# api.js turns this into "<origin>/api".
VITE_API_BASE_URL=https://aspirant-portal-api.adda247.com

# Google OAuth Web client ID (public). Ensure the OAuth client's "Authorized
# JavaScript origins" includes https://aspirant-portal.adda247.com.
VITE_GOOGLE_CLIENT_ID=903201516918-273gsp8a45pema0fj3mg84vbveqp2765.apps.googleusercontent.com
