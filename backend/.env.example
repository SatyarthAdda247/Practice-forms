# Backend environment. Export these before `python app.py`
# (or use a tool like python-dotenv / direnv).

# Required for Google sign-in — the SAME OAuth Web client ID used by the frontend.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign session tokens. MUST be set to a long random value in prod.
OMR_SECRET=change-me-to-a-long-random-string

# Optional: session lifetime in seconds (default 604800 = 7 days).
# OMR_SESSION_MAX_AGE=604800

# Email domains allowed to sign in (default shown).
OMR_ALLOWED_DOMAINS=adda247.com,studyiq.com,addaeducation.com

# Emails auto-granted the super-admin role on sign-in (comma-separated).
# The first super-admin MUST be listed here, or nobody can reach /admin.
OMR_SUPER_ADMIN_EMAILS=umesh.rao@adda247.com

# Emails auto-granted the (regular) admin role on sign-in (comma-separated).
OMR_ADMIN_EMAILS=

# ---- Deployment / server ----
# Host/port the dev server (python app.py) binds to. In containers set HOST=0.0.0.0.
# Most PaaS providers inject PORT automatically.
# HOST=127.0.0.1
# PORT=5000

# Enable Flask debug/reloader (dev only — never set in production).
# FLASK_DEBUG=0

# gunicorn worker count (production). Defaults to 4.
# WEB_CONCURRENCY=4

# Restrict CORS to specific origins in production (comma-separated).
# Leave unset to allow all origins (fine for local dev).
# Split-domain prod: this MUST be the frontend origin (scheme + host, no path).
OMR_CORS_ORIGINS=https://aspirant-portal.adda247.com

# ---- Database: everything -> BigQuery ----
# Users + exams/sheets/results all live in the Aspirant_portal dataset.

# --- Service-account credentials: pick ONE of the two forms below. ---
#
# (A) Inline JSON (recommended when the platform only injects env vars — no
#     mounted files/K8s). Paste the ENTIRE service-account key JSON, minified
#     onto a single line. The app writes it to a temp file at startup and wires
#     GOOGLE_APPLICATION_CREDENTIALS to it automatically. Takes precedence.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
# (B) Path to a key file. Drop the key in backend/credential/ (git-ignored) and
#     point here. A relative path is resolved against the backend/ directory; an
#     absolute path also works. Used only if the inline form above is unset.
GOOGLE_APPLICATION_CREDENTIALS=credential/adda247-dev-omr.json

# Handwritten student-name OCR via Google Cloud Vision (best-effort).
# Requires the Cloud Vision API enabled on the project + the SA allowed to call
# it. Set to 0 to disable (names stay blank). Failures are always non-fatal.
OMR_NAME_OCR=1

# BigQuery location of the tables.
BQ_PROJECT=adda247-dev
BQ_DATASET=Aspirant_portal
BQ_USERS_TABLE=users
# 'uuid' (default, scan-free string ids) or 'int' (only if users.id is INT64).
BQ_USERS_ID_MODE=uuid
# Seconds to cache user point-lookups (cuts per-request BigQuery cost). 0 disables.
BQ_USER_CACHE_TTL=30

# App-owned transactional tables (created automatically by init_db()).
BQ_EXAMS_TABLE=omr_exams
BQ_SHEETS_TABLE=omr_sheets
BQ_RESULTS_TABLE=omr_results

# ---- Public standalone tools (/image-resizer, /answerkey-checker) ----
# One append-only, DAY-partitioned table per tool, created automatically by
# tools_store.init(). Writes use the BigQuery streaming API, so the SA needs
# `bigquery.tables.updateData` on the dataset (dataEditor covers it) — these
# two do NOT need jobs.create.
BQ_TOOL_RESIZER_TABLE=tool_image_resizer
BQ_TOOL_KEYCHECK_TABLE=tool_answerkey_checker

# Per-IP write cap for the two PUBLIC tool endpoints, per minute. Best-effort
# and per-process (each gunicorn worker counts separately) — put a real limiter
# at the edge if these get real traffic.
OMR_TOOLS_RATE_LIMIT=30

# NOTE: the tools are served from the MAIN site (adda247.com), not the portal
# origin, so that origin must be added to OMR_CORS_ORIGINS above or the browser
# will block their logging calls. e.g.
# OMR_CORS_ORIGINS=https://aspirant-portal.adda247.com,https://adda247.com

# Hard ceiling on bytes BigQuery may bill for any single query (cost guardrail):
# a query that would scan more than this is rejected before it runs. Default is
# 1 GB — far above these small, clustered tables. Set 0 (or blank) to disable.
BQ_MAX_BYTES_BILLED=1000000000
